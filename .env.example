NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used by src/lib/email.ts for app notifications (e.g. "expense pending
# your approval"). Separate from Supabase's own SMTP config under
# Authentication > Emails, which only Supabase Auth itself can use - reuse
# the same Gmail account/App Password from that setup here too.
# If left blank, notifications are skipped (logged, not sent) rather than
# breaking whatever action triggered them.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
