# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local Claude Code permissions (machine-specific)
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# start-app.bat runtime log
/logs

# database backups (contain real expense data - never commit)
backup-*.sql
/backups

# migration script secrets (service role keys - never commit)
scripts/*.env.local

# account recovery codes - never commit
/Recovery-Code

# real filled-in bulk import data (contains actual expense records)
/data
/templates
