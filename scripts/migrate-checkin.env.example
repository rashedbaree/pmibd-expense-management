# Copy this file to migrate-checkin.env.local and fill in real values.
# migrate-checkin.env.local is gitignored - never commit real keys.
# Used by scripts/migrate-checkin-dev-to-prod.js

# --- SOURCE: where the standalone check-in app's data lives today (DEV) ---
# Supabase Dashboard -> DEV project -> Settings -> API -> Project URL
SOURCE_SUPABASE_URL=https://tmjomdqfkrytnyfkzxda.supabase.co
# Supabase Dashboard -> DEV project -> Settings -> API -> service_role key (SECRET - bypasses RLS)
SOURCE_SERVICE_ROLE_KEY=

# --- TARGET: where the data should end up ---
# For a dev rehearsal, point TARGET at the SAME dev project as above
# (it copies attendees -> checkin_attendees inside dev).
# For the real move, point TARGET at PROD:
#   Supabase Dashboard -> PROD project -> Settings -> API -> Project URL
TARGET_SUPABASE_URL=https://rjtdbbbymcfuvohzxkkb.supabase.co
#   ... -> service_role key (SECRET - bypasses RLS)
TARGET_SERVICE_ROLE_KEY=

# Only if the standalone app's tables were renamed (these are the defaults):
# SOURCE_ATTENDEES_TABLE=attendees
# SOURCE_SCAN_LOG_TABLE=scan_log
